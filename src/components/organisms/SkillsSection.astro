---
import { skillCategories } from '../../data/portfolio';
import Badge from '../atoms/Badge.astro';
import SectionHeading from '../atoms/SectionHeading.astro';
import TechIcon from '../atoms/TechIcon.astro';

const categoryIcons: Record<string, 'code' | 'database' | 'terminal'> = {
  Frontend: 'code',
  'Backend & Databases': 'database',
  'Tools & Methodologies': 'terminal',
};
---

<section id="habilidades" class="py-24 sm:py-32 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="// STACK TÉCNICO"
      title="Tecnologías & Metodologías"
      subtitle="Competencias en desarrollo web moderno, persistencia de datos, y flujos de ingeniería asistida por Inteligencia Artificial."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {skillCategories.map((group) => {
        const iconName = categoryIcons[group.category] || 'code';
        const isMethodologyGroup = group.category === 'Tools & Methodologies';

        return (
          <div
            class="glass-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:border-emerald-500/40 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-emerald-500/10 group"
            data-reveal="skill-card"
            data-spotlight-card
          >
            <div>
              <div class="flex items-center gap-3.5 mb-6">
                <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:scale-105 transition-transform">
                  <TechIcon name={iconName} size={22} />
                </div>
                <h3 class="text-lg sm:text-xl font-bold font-display text-white">
                  {group.category}
                </h3>
              </div>

              {(() => {
                const coreSkills = group.skills.filter(
                  (skill) =>
                    group.highlightedSkills?.includes(skill) ||
                    skill.includes('SDD') ||
                    skill.includes('HITL') ||
                    skill.includes('Spec Driven')
                );
                const secondarySkills = group.skills.filter(
                  (skill) => !coreSkills.includes(skill)
                );

                return (
                  <div class="space-y-4">
                    <div>
                      <span class="text-[10px] font-mono text-emerald-400 font-semibold uppercase tracking-wider block mb-2.5">
                        Stack Principal
                      </span>
                      <div class="flex flex-wrap gap-2">
                        {coreSkills.map((skill) => {
                          const isSDDOrHITL =
                            skill.includes('SDD') ||
                            skill.includes('HITL') ||
                            skill.includes('Spec Driven');
                          return (
                            <Badge
                              text={skill}
                              size="md"
                              variant={isSDDOrHITL ? 'methodology' : 'emerald'}
                            />
                          );
                        })}
                      </div>
                    </div>

                    {secondarySkills.length > 0 && (
                      <div class="pt-3 border-t border-slate-800/60">
                        <span class="text-[10px] font-mono text-slate-400 font-semibold uppercase tracking-wider block mb-2">
                          Ecosistema & Herramientas
                        </span>
                        <div class="flex flex-wrap gap-1.5">
                          {secondarySkills.map((skill) => (
                            <Badge
                              text={skill}
                              size="sm"
                              variant="default"
                            />
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                );
              })()}
            </div>

            {isMethodologyGroup && (
              <div class="mt-6 pt-4 border-t border-slate-800/80">
                <p class="text-xs text-cyan-300 font-mono">
                  ★ Enfoque pionero en desarrollo dirigido por especificaciones (SDD) y revisión humana en el bucle (HITL).
                </p>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
