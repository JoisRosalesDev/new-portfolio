---
import Button from '../atoms/Button.astro';
import Logo from '../atoms/Logo.astro';
import TechIcon from '../atoms/TechIcon.astro';

const navItems = [
  { label: 'Inicio', href: '#hero' },
  { label: 'Experiencia', href: '#experiencia' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Habilidades', href: '#habilidades' },
  { label: 'Educación', href: '#educacion' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 glass-nav transition-all duration-300 animate-fade-in-down">
  <!-- Interactive Top Scroll Progress Line -->
  <div
    id="scroll-progress-bar"
    class="absolute bottom-0 left-0 h-[3px] w-full bg-gradient-to-r from-emerald-400 via-cyan-400 to-emerald-300 shadow-[0_0_12px_#10b981] origin-left scale-x-0 pointer-events-none transition-transform duration-75 ease-out z-50"
    aria-hidden="true"
  ></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#hero" class="focus:outline-none focus:ring-2 focus:ring-emerald-400/50 rounded-xl p-1" aria-label="Ir al inicio del portafolio de Jois Rosales">
      <Logo size="md" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 bg-slate-900/60 p-1.5 rounded-full border border-slate-800 backdrop-blur-md">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3.5 py-1.5 rounded-full text-xs font-medium font-display text-slate-300 hover:text-white hover:bg-slate-800/80 transition-all focus:outline-none focus:ring-1 focus:ring-emerald-400"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="hidden sm:flex items-center gap-3">
      <Button
        href="#contacto"
        variant="primary"
        size="sm"
        class="text-xs font-semibold"
      >
        <span>Contáctame</span>
      </Button>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden w-10 h-10 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-emerald-400"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden px-4 pt-2 pb-6 glass-card border-b border-slate-800 bg-[#090d16]/95 backdrop-blur-2xl transition-all"
  >
    <nav class="flex flex-col gap-2 pt-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-link px-4 py-2.5 rounded-xl text-sm font-medium font-display text-slate-200 hover:text-white hover:bg-slate-850 transition-colors"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4 mt-2 border-t border-slate-800">
        <Button href="#contacto" variant="primary" size="md" class="w-full">
          Contáctame
        </Button>
      </div>
    </nav>
  </div>
</header>

<script>
  // 1. Mobile Menu Toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // 2. Cyber Scroll Progress Line (Native & Reliable)
  const progressBar = document.getElementById('scroll-progress-bar');
  function updateProgress() {
    if (!progressBar) return;
    const scrollY = window.scrollY || document.documentElement.scrollTop;
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    const progress = maxScroll > 0 ? Math.min(Math.max(scrollY / maxScroll, 0), 1) : 0;
    progressBar.style.transform = `scaleX(${progress})`;
  }

  // 3. Active Nav Link Scroll Spy
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('header nav a[href^="#"]');
  const sectionIds = ['hero', 'experiencia', 'proyectos', 'habilidades', 'educacion', 'contacto'];

  function updateActiveNav() {
    const scrollPos = (window.scrollY || document.documentElement.scrollTop) + 200;
    let currentId = 'hero';

    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (el) {
        const top = el.offsetTop;
        const height = el.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          currentId = id;
        }
      }
    }

    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (href === `#${currentId}`) {
        link.classList.add('active-nav-link');
      } else {
        link.classList.remove('active-nav-link');
      }
    });
  }

  // 4. Universal Interactive Spotlight Mouse Follower on ALL cards
  document.addEventListener('pointermove', (e: PointerEvent) => {
    const cards = document.querySelectorAll<HTMLElement>('.glass-card');
    cards.forEach((card) => {
      const rect = card.getBoundingClientRect();
      if (
        e.clientX >= rect.left - 60 &&
        e.clientX <= rect.right + 60 &&
        e.clientY >= rect.top - 60 &&
        e.clientY <= rect.bottom + 60
      ) {
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      }
    });
  }, { passive: true });

  // Bind scroll listeners
  window.addEventListener('scroll', () => {
    updateProgress();
    updateActiveNav();
  }, { passive: true });

  // Run on initial load
  updateProgress();
  updateActiveNav();
</script>
