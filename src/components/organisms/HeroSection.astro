---
import { personalInfo } from '../../data/portfolio';
import Button from '../atoms/Button.astro';
import TechIcon from '../atoms/TechIcon.astro';
---

<section id="hero" class="relative pt-32 sm:pt-40 lg:pt-48 pb-20 sm:pb-28 overflow-hidden">
  <!-- Decorative ambient lighting background glows with native Tailwind animations -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] sm:w-[700px] h-[350px] sm:h-[450px] bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none -z-10 animate-pulse-slow"></div>
  <div class="absolute top-1/3 right-10 w-[300px] h-[300px] bg-cyan-500/10 rounded-full blur-[100px] pointer-events-none -z-10 animate-float"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <!-- Live Status Badge: Pure obsidian & emerald tint, zero white borders -->
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-emerald-950/40 border border-emerald-500/25 mb-8 backdrop-blur-md shadow-sm animate-fade-in-up" data-hero-elem>
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="font-mono text-xs text-emerald-300/90 font-medium">
          Disponible para nuevas oportunidades
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black font-display tracking-tight text-white leading-[1.08] mb-6" data-hero-elem>
        Hola, soy <span class="text-gradient-emerald">{personalInfo.name}</span>
      </h1>

      <!-- Professional Subtitle -->
      <p class="text-lg sm:text-2xl font-bold font-display text-cyan-300 mb-6" data-hero-elem>
        {personalInfo.role}
      </p>

      <!-- Bio / Value Proposition with enhanced breathing room -->
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-10 max-w-2xl font-sans" data-hero-elem>
        {personalInfo.bio}
      </p>

      <!-- Primary Action Buttons & Socials -->
      <div class="flex flex-wrap items-center gap-4 pt-1" data-hero-elem>
        <Button
          href="#proyectos"
          variant="primary"
          size="lg"
        >
          <span>Ver Proyectos</span>
          <TechIcon name="external" size={16} />
        </Button>

        <Button
          href="#contacto"
          variant="secondary"
          size="lg"
        >
          <span>Contáctame</span>
          <TechIcon name="mail" size={16} />
        </Button>

        <!-- Social Icons with generous spacing and interactive hover glow -->
        <div class="flex items-center gap-3 sm:ml-3 pt-2 sm:pt-0">
          <a
            href={personalInfo.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 rounded-xl bg-slate-900/90 border border-slate-800 text-slate-400 hover:text-emerald-400 hover:border-emerald-500/40 hover:-translate-y-1 hover:shadow-lg hover:shadow-emerald-500/10 flex items-center justify-center transition-all duration-300"
            aria-label="Perfil de GitHub de Jois Rosales"
          >
            <TechIcon name="github" size={20} />
          </a>
          <a
            href={personalInfo.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 rounded-xl bg-slate-900/90 border border-slate-800 text-slate-400 hover:text-cyan-400 hover:border-cyan-500/40 hover:-translate-y-1 hover:shadow-lg hover:shadow-cyan-500/10 flex items-center justify-center transition-all duration-300"
            aria-label="Perfil de LinkedIn de Jois Rosales"
          >
            <TechIcon name="linkedin" size={20} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
