---
interface Props {
  text?: string;
  variant?: 'default' | 'methodology' | 'emerald' | 'cyan' | 'slate';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  text,
  variant = 'default',
  size = 'md',
  class: className = '',
} = Astro.props;

const baseStyles =
  'inline-flex items-center font-mono font-medium rounded-lg transition-all duration-200 select-none';

const sizeStyles = {
  sm: 'px-2 py-0.5 text-[11px] gap-1',
  md: 'px-2.5 py-1 text-xs gap-1.5',
};

const variantStyles = {
  default:
    'bg-slate-800/80 text-slate-300 border border-slate-700/60 hover:border-slate-600 hover:text-white',
  methodology:
    'bg-cyan-950/60 text-cyan-300 border border-cyan-500/30 hover:border-cyan-400 hover:bg-cyan-900/50 shadow-sm shadow-cyan-500/10',
  emerald:
    'bg-emerald-950/60 text-emerald-300 border border-emerald-500/30 hover:border-emerald-400 hover:bg-emerald-900/50 shadow-sm shadow-emerald-500/10',
  cyan:
    'bg-cyan-950/60 text-cyan-300 border border-cyan-500/30 hover:border-cyan-400 hover:bg-cyan-900/50',
  slate:
    'bg-slate-900/90 text-slate-400 border border-slate-800 hover:border-slate-700 hover:text-slate-300',
};

const classes = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

<span class={classes}>
  <slot>{text}</slot>
</span>
