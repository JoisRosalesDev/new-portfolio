---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'left',
  class: className = '',
} = Astro.props;

const alignmentClasses =
  align === 'center'
    ? 'text-center items-center mx-auto'
    : 'text-left items-start';
---

<div class={`flex flex-col mb-14 sm:mb-20 ${alignmentClasses} ${className}`} data-reveal="heading">
  {eyebrow && (
    <div class="inline-flex items-center gap-2.5 mb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="font-mono text-xs font-semibold tracking-wider text-emerald-400 uppercase">
        {eyebrow}
      </span>
    </div>
  )}

  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display tracking-tight text-white leading-tight">
    {title}
  </h2>

  {subtitle && (
    <p class="mt-4 text-base sm:text-lg text-slate-300/90 max-w-2xl leading-relaxed">
      {subtitle}
    </p>
  )}

  <div class="mt-6 h-1 w-20 rounded-full bg-gradient-to-r from-emerald-400 via-cyan-400 to-transparent"></div>
</div>
