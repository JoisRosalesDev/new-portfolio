---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  target?: string;
  rel?: string;
  download?: boolean | string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  target,
  rel,
  download,
  class: className = '',
  type = 'button',
  'aria-label': ariaLabel,
} = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center font-medium font-display transition-all duration-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-400/50 active:scale-[0.98] cursor-pointer select-none';

const sizeStyles = {
  sm: 'px-3.5 py-1.5 text-xs gap-1.5 min-h-[36px]',
  md: 'px-5 py-2.5 text-sm gap-2 min-h-[44px]',
  lg: 'px-6 py-3.5 text-base gap-2.5 min-h-[48px]',
};

const variantStyles = {
  primary:
    'bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/40 hover:-translate-y-0.5 btn-shimmer',
  secondary:
    'bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-800 hover:border-emerald-500/30 hover:-translate-y-0.5 backdrop-blur-sm shadow-sm',
  outline:
    'bg-transparent hover:bg-emerald-500/10 text-emerald-400 hover:text-emerald-300 border border-emerald-500/40 hover:border-emerald-400 hover:-translate-y-0.5',
  ghost:
    'bg-transparent hover:bg-slate-800/60 text-slate-300 hover:text-white',
};

const classes = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={target === '_blank' ? (rel || 'noopener noreferrer') : rel}
      download={download}
      class={classes}
      aria-label={ariaLabel}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
