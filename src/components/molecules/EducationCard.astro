---
import TechIcon from '../atoms/TechIcon.astro';

interface Props {
  title: string;
  subtitle: string;
  period?: string;
  badge?: string;
  description?: string;
}

const { title, subtitle, period, badge, description } = Astro.props;
---

<div class="glass-card rounded-2xl p-6 transition-all duration-300 hover:border-emerald-500/40 hover:-translate-y-1 flex flex-col justify-between" data-reveal="education">
  <div>
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shrink-0">
        <TechIcon name="sparkles" size={20} />
      </div>
      {badge && (
        <span class="font-mono text-[11px] font-semibold text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 px-2.5 py-0.5 rounded-full">
          {badge}
        </span>
      )}
    </div>

    <h3 class="text-lg sm:text-xl font-bold font-display text-white mb-1">
      {title}
    </h3>
    <p class="text-sm font-medium text-cyan-300 font-display mb-2">
      {subtitle}
    </p>

    {description && (
      <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mt-2">
        {description}
      </p>
    )}
  </div>

  {period && (
    <div class="mt-4 pt-3 border-t border-slate-800 flex items-center gap-1.5 text-xs font-mono text-slate-400">
      <TechIcon name="calendar" size={12} />
      <span>{period}</span>
    </div>
  )}
</div>
