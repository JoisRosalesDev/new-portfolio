---
import TechIcon from '../atoms/TechIcon.astro';

interface Props {
  title: string;
  subtitle: string;
  period?: string;
  badge?: string;
  description?: string;
  image?: string;
}

const { title, subtitle, period, badge, description, image } = Astro.props;
---

<div class="glass-card rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:border-emerald-500/40 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-emerald-500/10 flex flex-col justify-between group" data-reveal="education" data-spotlight-card>
  <div>
    {image && (
      <div class="relative w-full h-44 sm:h-48 rounded-xl overflow-hidden mb-5 bg-slate-900 border border-slate-800/80">
        <img
          src={image}
          alt={`Acreditación de ${title}`}
          loading="lazy"
          decoding="async"
          width={800}
          height={600}
          class="w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-transparent pointer-events-none"></div>
      </div>
    )}

    <div class="flex items-start justify-between gap-3 mb-4">
      <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shrink-0">
        <TechIcon name="sparkles" size={20} />
      </div>
      {badge && (
        <span class="font-mono text-[11px] font-semibold text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 px-2.5 py-0.5 rounded-full">
          {badge}
        </span>
      )}
    </div>

    <h3 class="text-lg sm:text-xl font-bold font-display text-white mb-2 group-hover:text-emerald-300 transition-colors">
      {title}
    </h3>
    <p class="text-sm font-medium text-cyan-300 font-display mb-3">
      {subtitle}
    </p>

    {description && (
      <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mt-3">
        {description}
      </p>
    )}
  </div>

  {period && (
    <div class="mt-6 pt-4 border-t border-slate-800 flex items-center gap-2 text-xs font-mono text-slate-400">
      <TechIcon name="calendar" size={13} />
      <span>{period}</span>
    </div>
  )}
</div>

