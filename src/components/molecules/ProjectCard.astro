---
import type { Project } from '../../types/portfolio';
import Badge from '../atoms/Badge.astro';
import Button from '../atoms/Button.astro';
import TechIcon from '../atoms/TechIcon.astro';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className = '' } = Astro.props;
---

<article
  class={`glass-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:border-emerald-500/40 hover:shadow-xl hover:shadow-emerald-500/10 group ${className}`}
  data-reveal="card"
  data-spotlight-card
>
  <div>
    <!-- Card Media / Preview Header -->
    <div class="relative w-full h-48 sm:h-56 rounded-xl overflow-hidden mb-6 bg-slate-900 border border-slate-800/80 flex items-center justify-center group-hover:border-emerald-500/40 transition-colors">
      {project.image ? (
        <div class="w-full h-full relative overflow-hidden">
          <img
            src={project.image}
            alt={`Captura del proyecto ${project.title}`}
            loading="lazy"
            decoding="async"
            width={1280}
            height={720}
            class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent pointer-events-none"></div>
        </div>
      ) : (
        <div class="relative z-10 text-center p-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center mx-auto mb-2 text-emerald-400 group-hover:scale-110 transition-transform duration-300">
            <TechIcon name="code" size={24} />
          </div>
          <span class="font-mono text-xs text-slate-400 font-semibold tracking-wider uppercase">
            {project.id}
          </span>
        </div>
      )}

      <!-- Accent Top Badge for Featured Projects -->
      {project.featured && (
        <div class="absolute top-3 right-3 z-20">
          <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-semibold bg-slate-950/90 text-emerald-400 border border-emerald-500/30 backdrop-blur-md shadow-sm">
            Featured
          </span>
        </div>
      )}
    </div>

    <!-- Titles with generous spacing -->
    <div class="mb-4">
      <span class="font-mono text-xs font-semibold text-cyan-400 tracking-wider uppercase block mb-1.5">
        {project.subtitle}
      </span>
      <h3 class="text-xl sm:text-2xl font-bold font-display text-white group-hover:text-emerald-300 transition-colors">
        {project.title}
      </h3>
    </div>

    <!-- Description -->
    <p class="text-sm text-slate-300 leading-relaxed mb-6">
      {project.description}
    </p>

    <!-- Tech Stack Badges with enhanced rhythm -->
    <div class="flex flex-wrap gap-2 mb-7">
      {project.tags.map((tag) => {
        const isMethodology = tag.includes('SDD') || tag.includes('HITL') || tag.includes('AI');
        return (
          <Badge
            text={tag}
            size="sm"
            variant={isMethodology ? 'methodology' : 'default'}
          />
        );
      })}
    </div>
  </div>

  <!-- Dual Action Buttons: Demo & GitHub with ample spacing -->
  <div class="pt-5 border-t border-slate-800/80 flex items-center gap-4">
    <Button
      href={project.demoUrl}
      target="_blank"
      rel="noopener noreferrer"
      variant="primary"
      size="sm"
      class="flex-1"
      aria-label={`Ver demo en vivo de ${project.title}`}
    >
      <span>Demo</span>
      <TechIcon name="external" size={14} />
    </Button>

    <Button
      href={project.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      variant="secondary"
      size="sm"
      class="flex-1"
      aria-label={`Ver repositorio en GitHub de ${project.title}`}
    >
      <TechIcon name="github" size={15} />
      <span>GitHub</span>
    </Button>
  </div>
</article>
