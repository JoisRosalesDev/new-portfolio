---
import type { Project } from '../../types/portfolio';
import Badge from '../atoms/Badge.astro';
import Button from '../atoms/Button.astro';
import TechIcon from '../atoms/TechIcon.astro';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className = '' } = Astro.props;
---

<article
  class={`glass-card rounded-2xl p-5 sm:p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:border-emerald-500/40 hover:shadow-xl hover:shadow-emerald-500/10 group ${className}`}
  data-reveal="card"
>
  <div>
    <!-- Card Media / Preview Header -->
    <div class="relative w-full h-48 sm:h-52 rounded-xl overflow-hidden mb-5 bg-gradient-to-br from-slate-900 via-slate-850 to-slate-800 border border-slate-750/70 flex items-center justify-center group-hover:border-emerald-500/30 transition-colors">
      <!-- Decorative geometric pattern representing dev architecture -->
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:16px_16px]"></div>
      
      <div class="relative z-10 text-center p-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center mx-auto mb-2 text-emerald-400 group-hover:scale-110 transition-transform duration-300">
          <TechIcon name="code" size={24} />
        </div>
        <span class="font-mono text-xs text-slate-400 font-semibold tracking-wider uppercase">
          {project.id}
        </span>
      </div>

      <!-- Accent Top Badge -->
      <div class="absolute top-3 right-3 z-20">
        <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-semibold bg-slate-950/80 text-emerald-400 border border-emerald-500/30 backdrop-blur-md">
          Featured
        </span>
      </div>
    </div>

    <!-- Titles -->
    <div class="mb-3">
      <span class="font-mono text-xs font-semibold text-cyan-400 tracking-wide uppercase block mb-1">
        {project.subtitle}
      </span>
      <h3 class="text-xl sm:text-2xl font-bold font-display text-white group-hover:text-emerald-300 transition-colors">
        {project.title}
      </h3>
    </div>

    <!-- Description -->
    <p class="text-sm text-slate-300 leading-relaxed mb-5">
      {project.description}
    </p>

    <!-- Tech Stack Badges -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {project.tags.map((tag) => {
        const isMethodology = tag.includes('SDD') || tag.includes('HITL') || tag.includes('AI');
        return (
          <Badge
            text={tag}
            size="sm"
            variant={isMethodology ? 'methodology' : 'default'}
          />
        );
      })}
    </div>
  </div>

  <!-- Dual Action Buttons: Demo & GitHub -->
  <div class="pt-4 border-t border-slate-800/80 flex items-center gap-3">
    <Button
      href={project.demoUrl}
      target="_blank"
      rel="noopener noreferrer"
      variant="primary"
      size="sm"
      class="flex-1"
      aria-label={`Ver demo en vivo de ${project.title}`}
    >
      <span>Demo</span>
      <TechIcon name="external" size={14} />
    </Button>

    <Button
      href={project.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      variant="secondary"
      size="sm"
      class="flex-1"
      aria-label={`Ver repositorio en GitHub de ${project.title}`}
    >
      <TechIcon name="github" size={15} />
      <span>GitHub</span>
    </Button>
  </div>
</article>
