---
import type { ExperienceRole } from '../../types/portfolio';
import TechIcon from '../atoms/TechIcon.astro';

interface Props {
  company: string;
  roles: ExperienceRole[];
}

const { company, roles } = Astro.props;
---

<div class="glass-card rounded-2xl p-6 sm:p-8 relative overflow-hidden" data-reveal="experience">
  <!-- Accent corner border glow -->
  <div class="absolute -top-10 -right-10 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

  <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-800">
    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
      <TechIcon name="terminal" size={20} />
    </div>
    <div>
      <span class="text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold block">
        Empresa
      </span>
      <h3 class="text-xl sm:text-2xl font-bold font-display text-white">
        {company}
      </h3>
    </div>
  </div>

  <div class="space-y-8 relative pl-6 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-gradient-to-b before:from-emerald-400 before:via-cyan-500 before:to-slate-700">
    {roles.map((role) => (
      <div class="relative group">
        <!-- Timeline node dot -->
        <span class="absolute -left-[27px] top-1.5 w-3 h-3 rounded-full bg-slate-900 border-2 border-emerald-400 group-hover:bg-emerald-400 group-hover:scale-125 transition-all"></span>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
          <h4 class="text-lg font-bold font-display text-emerald-300">
            {role.title}
          </h4>
          <span class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-400 bg-slate-850 px-2.5 py-1 rounded-md border border-slate-750 self-start sm:self-auto">
            <TechIcon name="calendar" size={12} />
            {role.period}
          </span>
        </div>

        <ul class="mt-3 space-y-2.5">
          {role.achievements.map((achievement) => (
            <li class="flex items-start gap-2.5 text-sm text-slate-300 leading-relaxed">
              <span class="mt-1 text-emerald-400 shrink-0">
                <TechIcon name="check" size={14} />
              </span>
              <span>{achievement}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
