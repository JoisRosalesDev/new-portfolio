---
import type { ExperienceRole } from '../../types/portfolio';
import TechIcon from '../atoms/TechIcon.astro';

interface Props {
  company: string;
  roles: ExperienceRole[];
}

const { company, roles } = Astro.props;
---

<div class="glass-card rounded-2xl px-5 sm:px-6 pt-4 sm:pt-5 pb-5 sm:pb-6 relative overflow-hidden" data-reveal="experience" data-spotlight-card>
  <!-- Accent corner border glow -->
  <div class="absolute -top-10 -right-10 size-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

  <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-slate-800/80">
    <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0">
      <TechIcon name="terminal" size={16} />
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="text-base sm:text-lg font-bold font-display text-white leading-none">
        {company}
      </h3>
      <span class="text-[10px] font-mono uppercase tracking-wider text-emerald-400/90 font-semibold px-2 py-0.5 rounded-full bg-emerald-950/60 border border-emerald-500/20">
        Empresa
      </span>
    </div>
  </div>

  <div class="space-y-7 relative pl-6 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-gradient-to-b before:from-emerald-400 before:via-cyan-500 before:to-slate-800">
    {roles.map((role) => (
      <div class="relative group">
        <!-- Timeline node dot -->
        <span class="absolute -left-[27px] top-1.5 w-3 h-3 rounded-full bg-slate-900 border-2 border-emerald-400 group-hover:bg-emerald-400 group-hover:scale-125 transition-all"></span>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
          <h4 class="text-base sm:text-lg font-bold font-display text-emerald-300">
            {role.title}
          </h4>
          <span class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-400 bg-slate-900/90 px-2.5 py-1 rounded-md border border-slate-800 self-start sm:self-auto shadow-sm">
            <TechIcon name="calendar" size={12} />
            {role.period}
          </span>
        </div>

        <ul class="mt-2.5 space-y-2">
          {role.achievements.map((achievement) => (
            <li class="flex items-start gap-2.5 text-sm text-slate-300 leading-relaxed">
              <span class="mt-1 text-emerald-400 shrink-0">
                <TechIcon name="check" size={14} />
              </span>
              <span>{achievement}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
